<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="0dp">

    <TextView
        android:id="@+id/tempo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="#5EE0A8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/voltar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circulo_grafite"
            android:contentDescription="Voltar"
            android:padding="9dp"
            android:src="@drawable/ic_voltar" />

        <ImageButton
            android:id="@+id/play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_circulo_menta"
            android:contentDescription="Pausar"
            android:padding="12dp"
            android:src="@drawable/ic_pausa_escuro" />

        <ImageButton
            android:id="@+id/avancar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circulo_grafite"
            android:contentDescription="Avançar"
            android:padding="9dp"
            android:src="@drawable/ic_avancar" />
    </LinearLayout>
</LinearLayout>
